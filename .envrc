# Use nix-shell for development environment
use nix

# Create logs directory if it doesn't exist
mkdir -p logs
mkdir -p config
mkdir -p data

# Set environment variables for the project
export PROJECT_ROOT=$(pwd)
export LOG_LEVEL=DEBUG
export MONITOR_CONFIG_PATH="$PROJECT_ROOT/config/targets.yaml"
export MONITOR_LOG_PATH="$PROJECT_ROOT/logs"

# Python path for local development
export PYTHONPATH="$PROJECT_ROOT:$PYTHONPATH"

# Prometheus metrics port (configurable)
export PROMETHEUS_PORT=8000

# Docker socket (adjust if needed for your setup)
export DOCKER_HOST="unix:///var/run/docker.sock"

echo "🔧 Development environment loaded!"
echo "   Project root: $PROJECT_ROOT"
echo "   Config path: $MONITOR_CONFIG_PATH"
echo "   Log path: $MONITOR_LOG_PATH"
echo "   Prometheus port: $PROMETHEUS_PORT"
